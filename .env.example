# Token de acesso da API do Asaas (gerado no painel: Integracoes > Chaves API)
ASAAS_ACCESS_TOKEN=

# Ambiente da Asaas: sandbox (testes) ou production
ASAAS_ENV=sandbox

# URL publica deste backend depois do deploy no Railway (ex: https://seu-app.up.railway.app)
BASE_URL=https://reposi1-production.up.railway.app

# URL do seu site/checkout (frontend) para redirecionar apos pagamento
FRONTEND_SUCCESS_URL=

# Chave de API do Resend (gerada no painel do Resend)
RESEND_API_KEY=

# Email que vai aparecer como remetente (pode ser o padrao do Resend em testes)
EMAIL_FROM=onboarding@resend.dev

# Email que vai RECEBER os avisos de pagamento (o seu email)
EMAIL_TO=

PORT=8080
